# =============================================================================
# Mini CMS - Root environment file
# =============================================================================
# Copy this file to `.env` at the repository root:
#   Windows PowerShell : Copy-Item .env.example .env
#   macOS / Linux      : cp .env.example .env
#
# This file is consumed by `docker-compose.yml`.
# The NestJS backend reads its own copy from `backend/.env`
# (see `backend/.env.example`).
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL container
# -----------------------------------------------------------------------------
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=cms_password
POSTGRES_DB=cms_db

# Host port that PostgreSQL is published on.
#
# If you already have PostgreSQL installed natively it will own port 5432, and
# the container silently loses the race for it: connections to localhost:5432
# reach your local server instead and fail with
# "P1000: Authentication failed ... for cms_user". Set this to 5433 (and match
# the port in DATABASE_URL below) if that happens. Check with:
#   Get-NetTCPConnection -LocalPort 5432 -State Listen
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Database connection strings
# -----------------------------------------------------------------------------
# Used when running the backend on the host machine (npm run start:dev).
DATABASE_URL=postgresql://cms_user:cms_password@localhost:5432/cms_db?schema=public

# Used when the backend runs inside Docker Compose. The hostname is the
# compose service name, and the port is the container-internal 5432.
DATABASE_URL_DOCKER=postgresql://cms_user:cms_password@postgres:5432/cms_db?schema=public

# Shared staging database on Neon. Leave blank until the Neon branch exists.
DATABASE_URL_STAGING=

# -----------------------------------------------------------------------------
# Backend (NestJS)
# -----------------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=4000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# Rate limiting: THROTTLE_LIMIT requests allowed per THROTTLE_TTL milliseconds.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
