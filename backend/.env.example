# =============================================================================
# Mini CMS - Backend environment file
# =============================================================================
# Copy this file to `backend/.env`:
#   Windows PowerShell : Copy-Item .env.example .env
#   macOS / Linux      : cp .env.example .env
#
# The Prisma CLI reads DATABASE_URL from this file when you run
# `npm run db:migrate`, `npm run db:seed` or `npm run db:studio`
# from inside the `backend/` directory.
# =============================================================================

# Local PostgreSQL started by `docker compose up -d postgres`.
#
# Must match POSTGRES_PORT in the root .env. Use 5433 if you already run a
# native PostgreSQL on 5432, otherwise Prisma connects to that server instead
# and reports "P1000: Authentication failed ... for cms_user".
DATABASE_URL=postgresql://cms_user:cms_password@localhost:5432/cms_db?schema=public

NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# Rate limiting: THROTTLE_LIMIT requests allowed per THROTTLE_TTL milliseconds.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
