# Tuned for unreliable / high-latency connections. The defaults open many
# parallel sockets, which triggers ECONNRESET on weak links and leaves
# half-extracted packages behind.
maxsockets=3
fetch-retries=10
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=900000

# Keeps installs quiet and quick; run `npm audit` explicitly when needed.
audit=false
fund=false

# Exact versions are pinned in package.json on purpose.
save-exact=true
